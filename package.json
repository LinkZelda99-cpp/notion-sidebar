{
  "name": "notion-sidebar",
  "displayName": "Notion Sidebar",
  "description": "Notion workspace inside VS Code",
  "publisher": "linkzelda99-cpp",
  "icon": "media/extension-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/LinkZelda99-cpp/notion-sidebar.git"
  },
  "version": "0.1.1",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "notion-sidebar",
          "title": "Notion",
          "icon": "media/notion.svg"
        }
      ]
    },
    "views": {
      "notion-sidebar": [
        {
          "type": "webview",
          "id": "notion-sidebar.view",
          "name": "Notion",
          "icon": "media/notion.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "notion-sidebar.signIn",
        "title": "Notion: Sign In"
      },
      {
        "command": "notion-sidebar.signOut",
        "title": "Notion: Sign Out"
      },
      {
        "command": "notion-sidebar.openNotion",
        "title": "Notion: Open in Browser"
      },
      {
        "command": "notion-sidebar.refresh",
        "title": "Notion: Refresh"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.136.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@notionhq/client": "^5.26.0"
  }
}